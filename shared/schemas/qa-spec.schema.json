{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-test-factory.local/schemas/qa-spec.schema.json",
  "title": "QA Specification",
  "type": "object",
  "required": ["specId", "version", "title", "acceptanceCriteria", "testStrategy"],
  "properties": {
    "specId": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "given", "when", "then"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "given": { "type": "string" },
          "when": { "type": "string" },
          "then": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "risks": { "type": "array", "items": { "type": "string" } },
    "testStrategy": {
      "type": "object",
      "properties": {
        "unit": { "type": "array", "items": { "type": "string" } },
        "integration": { "type": "array", "items": { "type": "string" } },
        "api": { "type": "array", "items": { "type": "string" } },
        "e2e": { "type": "array", "items": { "type": "string" } },
        "accessibility": { "type": "array", "items": { "type": "string" } },
        "performance": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
